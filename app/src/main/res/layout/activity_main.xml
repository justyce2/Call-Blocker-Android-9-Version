<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Call Blocker"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠ Call Blocker is NOT active"
        android:textSize="18sp"
        android:textAlignment="center"
        android:textColor="#F44336"
        android:layout_marginBottom="32dp"
        android:padding="16dp"
        android:background="#F5F5F5"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:id="@+id/instructionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To activate call blocking, tap the button below and allow all permissions."
        android:textSize="14sp"
        android:textAlignment="center"
        android:textColor="#666666"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="4dp" />

    <Button
        android:id="@+id/enableButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Call Blocking"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#4CAF50"
        android:padding="16dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Blocks calls starting with: 0700, 0201, 070806, 0209, 0723"
        android:textSize="12sp"
        android:textAlignment="center"
        android:textColor="#999999"
        android:layout_marginTop="32dp" />

</LinearLayout>
